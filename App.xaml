<Application x:Class="GUIForDiskpart.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUIForDiskpart;component/Win95Button.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="ThemeWindowBrush" Color="#FF8C8C8C"/>
            <SolidColorBrush x:Key="ThemeTextBrush" Color="Black"/>
            <SolidColorBrush x:Key="ThemeButtonBrush" Color="#FFC3C3C3"/>
            <SolidColorBrush x:Key="ThemeTileBrush" Color="#FFA5A4A4"/>
            <SolidColorBrush x:Key="ThemeBorderBrush" Color="#FF676767"/>
            <SolidColorBrush x:Key="ThemeInputBrush" Color="White"/>
            <SolidColorBrush x:Key="ThemeMenuBrush" Color="#FFF0F0F0"/>
            <SolidColorBrush x:Key="ThemeTableBrush" Color="White"/>
            <SolidColorBrush x:Key="ThemeTableRowBrush" Color="#FFC7C7C7"/>
            <SolidColorBrush x:Key="ThemeTableAlternateBrush" Color="#FFF3F5E0"/>
            <SolidColorBrush x:Key="ThemeSearchBrush" Color="#FF3C3C3C"/>
            <SolidColorBrush x:Key="ThemeSearchTextBrush" Color="#FFE4E4E4"/>
            <SolidColorBrush x:Key="ThemeLogBrush" Color="#FF252525"/>
            <SolidColorBrush x:Key="ThemeLogTextBrush" Color="#FF009409"/>
            <SolidColorBrush x:Key="ThemePressedBrush" Color="#FFC0C0C0"/>
            <SolidColorBrush x:Key="ThemeBevelLightBrush" Color="White"/>
            <SolidColorBrush x:Key="ThemeBevelShadowBrush" Color="#FF828282"/>
            <SolidColorBrush x:Key="ThemeBevelDarkBrush" Color="Black"/>
            <SolidColorBrush x:Key="ThemePressedHighlightBrush" Color="#FFDFDFDF"/>
            <SolidColorBrush x:Key="ThemeDangerBrush" Color="#FFB90000"/>

            <Style TargetType="{x:Type Window}">
                <Setter Property="Background" Value="{DynamicResource ThemeWindowBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type Label}">
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type RadioButton}">
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            </Style>
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            </Style>
            <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type Menu}">
                <Setter Property="Background" Value="{DynamicResource ThemeMenuBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Background" Value="{DynamicResource ThemeMenuBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="Background" Value="{DynamicResource ThemeMenuBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="Background" Value="{DynamicResource ThemeMenuBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            </Style>
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="{DynamicResource ThemeMenuBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type ProgressBar}">
                <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}"/>
            </Style>
            <Style TargetType="{x:Type DataGrid}">
                <Setter Property="Background" Value="{DynamicResource ThemeTableBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            </Style>
            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="{DynamicResource ThemeMenuBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
